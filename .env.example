# Jairbet settings. Copy to .env, fill in, and keep it private (chmod 600).

# Bot token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# API key from https://www.football-data.org/client/register (free plan).
# Leave empty to disable automatic sync.
FOOTBALL_DATA_TOKEN=

# Telegram user IDs. Send /chatid to the bot to see yours.
# Several admins can be separated with commas.
ADMIN_TELEGRAM_IDS=
JAIR_TELEGRAM_ID=

# Group that receives results (negative number). Add the bot to the group and
# send /chatid there. Leave empty to send results privately instead.
GROUP_CHAT_ID=

# Where data lives. Empty means jairbet.db and backups/ in the project folder.
DB_PATH=
BACKUP_DIR=

# Timezone for kickoff times, reminders and the daily schedule.
TZ_NAME=America/Sao_Paulo
